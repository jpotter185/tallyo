{
  "name": "tallyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint --fix",
    "gen:api-types": "ruby scripts/generate-api-types.rb ${OPENAPI_PATH:-../tallyo-backend/openapi.yaml} src/types/api.generated.ts && prettier --write src/types/api.generated.ts",
    "check:api-contract": "npm run gen:api-types && git diff --exit-code -- src/types/api.generated.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
